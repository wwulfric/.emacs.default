;;; source-context-tests.el -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(setq load-prefer-newer t)
(add-to-list 'load-path (expand-file-name "lisp"))
(add-to-list 'load-path (expand-file-name "lisp/lsp-bridge"))
(require 'lsp-bridge-source)
(require 'frame-setting)
(require 'init-tab-line)

(ert-deftest source-project-context-and-switch ()
  (let ((origin (expand-file-name default-directory))
        (second "/Users/bytedance/projects/study/Haxl/"))
    (with-temp-buffer
      (setq default-directory temporary-file-directory
            buffer-file-name (expand-file-name "Traversable.hs" temporary-file-directory)
            lsp-bridge-source--reading t
            lsp-bridge-source--origin `((project . ,origin)))
      (lsp-bridge-source-mode 1)
      (should (equal (expand-file-name (project-root (project-current nil))) origin))
      (should (equal default-directory temporary-file-directory))
      (let ((project-current-directory-override second))
        (should (equal (expand-file-name (project-root (project-current nil))) second)))
      (should (equal (expand-file-name (project-root (project-current nil second))) second))
      (should (string-prefix-p ".emacs.d" (my/frame-title)))
      (setq lsp-bridge-source--origin `((project . ,second)))
      (run-hooks 'lsp-bridge-source-context-update-hook)
      (should (equal (expand-file-name (project-root (project-current nil))) second))
      (should (string-prefix-p "Haxl" (my/frame-title)))
      (lsp-bridge-source-mode -1)
      (should-not (lsp-bridge-source-buffer-p))
      (should-not (memq #'lsp-bridge-source--find-project project-find-functions)))))

(ert-deftest source-tab-label-and-button ()
  (with-temp-buffer
    (rename-buffer "Traversable%test.hs" t)
    (setq lsp-bridge-source--reading t
          lsp-bridge-source--origin `((project . ,default-directory)))
    (lsp-bridge-source-mode 1)
    (let* ((buffer (current-buffer))
           (my/tab-line-hover-target (cons (selected-window) buffer))
           (label (my/tab-line-format-with-padding buffer (list buffer)))
           (badge (string-match (regexp-quote "[依赖]") label))
           (close (string-match "×" label)))
      (should-not badge)
      (should close)
      (should (memq 'my/tab-line-source (get-text-property 0 'face label)))
      (should (memq 'my/tab-line-source (get-text-property close 'face label)))
      (should (memq 'my/tab-line-source (get-text-property (1- (length label)) 'face label)))
      (should (string-match-p "来源：" (get-text-property 1 'help-echo label)))
      (should (equal "Click to close tab" (get-text-property close 'help-echo label)))
      (should (eq tab-line-tab-close-map (get-text-property close 'keymap label))))
    (lsp-bridge-source-mode -1)
    (should-not (string-match-p "依赖" (funcall tab-line-tab-name-function (current-buffer) nil)))))

(ert-deftest source-unmanaged-and-missing-origin ()
  (with-temp-buffer
    (lsp-bridge-source-mode 1)
    (should-not (lsp-bridge-source-buffer-p))
    (should-not lsp-bridge-source--project)
    (setq lsp-bridge-source--reading t
          lsp-bridge-source--origin '((project . "/nonexistent/source-origin/")))
    (run-hooks 'lsp-bridge-source-context-update-hook)
    (should-not lsp-bridge-source--project)
    (should (stringp (my/frame-title)))))

(ert-deftest source-resolution-propagates-context-and-return ()
  (let ((files (list (make-temp-file "source-context-a-" nil ".hs" "module A where\n")
                     (make-temp-file "source-context-b-" nil ".hs" "module B where\n")))
        (lsp-bridge-source-enable t)
        (lsp-bridge-flash-region-delay 0)
        (updates 0)
        (origin-dir default-directory))
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (switch-to-buffer (current-buffer))
            (setq major-mode 'haskell-mode buffer-file-name "/tmp/Origin.hs")
            (let ((origin (current-buffer))
                  (lsp-bridge-source-context-update-hook
                   (cons (lambda () (cl-incf updates)) lsp-bridge-source-context-update-hook)))
              (dolist (file files)
                (setq major-mode 'haskell-mode)
                (should (lsp-bridge-source--capture "jump" nil))
                (lsp-bridge-source--resolved lsp-bridge-source--context nil
                  `((result (path . ,file) (line . 0) (character . 0))))
                (set-buffer (window-buffer))
                (should (lsp-bridge-source-buffer-p))
                (should (equal (lsp-bridge-source-origin-directory) origin-dir))
                (should (equal (expand-file-name (project-root (project-current nil)))
                               (expand-file-name origin-dir))))
              (should (= updates 2))
              (lsp-bridge-find-def-return)
              (should (equal buffer-file-name (car files)))
              (lsp-bridge-find-def-return)
              (should (eq (current-buffer) origin)))))
      (dolist (file files)
        (when-let* ((buffer (find-buffer-visiting file))) (kill-buffer buffer))
        (delete-file file)))))

(ert-run-tests-batch-and-exit)
