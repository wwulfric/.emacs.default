;;; init-workspace-tests.el --- Workspace session regression tests -*- lexical-binding: t; -*-

;; Run: emacs -Q --batch -L lisp -L lisp/ui -l tests/init-workspace-tests.el -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)

;; Never touch the real var/ directory.
(setq user-emacs-directory (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (make-temp-file "workspace-home" t))))
(require 'init-workspace)
(require 'init-welcome)
(require 'tab-line)

(setq my/workspace-lazy-restore nil)

(defmacro my/ws-test-with-project (files &rest body)
  "Run BODY with `root' bound to a temporary project holding FILES."
  (declare (indent 1))
  `(let* ((root (my/workspace-normalize-root (make-temp-file "workspace-project" t)))
          (my/workspace--meta nil))
     (unwind-protect
         (progn
           (dolist (file ,files)
             (let ((path (expand-file-name file root)))
               (make-directory (file-name-directory path) t)
               (with-temp-file path
                 (dotimes (line 200) (insert (format "%s line %d\n" file line))))))
           ,@body)
       (my/workspace--cancel-queue)
       (set-frame-parameter nil 'my/workspace-root nil)
       (set-frame-parameter nil 'my/workspace-saved nil)
       (delete-other-windows)
       (switch-to-buffer (get-scratch-buffer-create))
       (set-window-prev-buffers nil nil)
       (set-window-next-buffers nil nil)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (string-prefix-p (expand-file-name root) (buffer-file-name buffer)))
           (kill-buffer buffer)))
       (delete-directory root t))))

(defun my/ws-test-visit (root file line)
  "Show FILE of ROOT in the selected window with point on LINE."
  (switch-to-buffer (find-file-noselect (expand-file-name file root)))
  (goto-char (point-min))
  (forward-line (1- line)))

(defun my/ws-test-tabs (window)
  "Return WINDOW's tab-line file names, left to right."
  (with-selected-window window
    (mapcar (lambda (buffer) (file-name-nondirectory (buffer-file-name buffer)))
            (seq-filter #'buffer-file-name (tab-line-tabs-window-buffers)))))

(ert-deftest my/welcome-open-directory-keeps-selected-folder-under-a-project ()
  (my/ws-test-with-project '("nested/file.txt")
    (let* ((directory (expand-file-name "nested/" root))
           (expected (my/workspace-normalize-root directory))
           (project (cons 'transient root))
           remembered)
      ;; An enclosing repository must not replace the directory the user chose
      ;; or appear as a newly opened project in the recent list.
      (cl-letf (((symbol-function 'project-current) (lambda (&rest _) project))
                ((symbol-function 'project-remember-project)
                 (lambda (value &rest _) (push value remembered))))
        (my/welcome-open-directory directory)
        (should (equal (frame-parameter nil 'my/workspace-root) expected))
        (should (equal default-directory directory))
        (should (my/workspace-meta-get expected))
        (should-not remembered)))))

(ert-deftest my/workspace-startup-directory-keeps-selected-folder ()
  (let ((directory "/tmp/parent/selected/") opened)
    (cl-letf (((symbol-function 'my/sidebar-take-startup-directory)
               (lambda () directory))
              ((symbol-function 'my/workspace-open)
               (lambda (root &rest _) (setq opened root)))
              ((symbol-function 'project-current)
               (lambda (&rest _) (ert-fail "Directory opening searched parents"))))
      (my/workspace-startup)
      (should (equal opened directory)))))

(ert-deftest my/welcome-open-directory-still-remembers-project-root ()
  (my/ws-test-with-project nil
    (let ((project (cons 'transient root)) remembered)
      (cl-letf (((symbol-function 'project-current) (lambda (&rest _) project))
                ((symbol-function 'project-remember-project)
                 (lambda (value &rest _) (push value remembered))))
        (my/welcome-open-directory root)
        (should (equal (frame-parameter nil 'my/workspace-root) root))
        (should (equal remembered (list project)))))))

(ert-deftest my/workspace-round-trip-restores-layout-tabs-and-points ()
  (my/ws-test-with-project '("a.el" "b.el" "src/c.el" "src/d.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (my/ws-test-visit root "a.el" 10)
    (my/ws-test-visit root "b.el" 20)
    (let ((right (split-window-right)))
      (with-selected-window right
        (my/ws-test-visit root "src/c.el" 30)
        (my/ws-test-visit root "src/d.el" 40)))
    (let ((left-tabs (my/ws-test-tabs (selected-window)))
          (right-tabs (my/ws-test-tabs (next-window))))
      (my/workspace-save nil t)
      ;; Lose everything: one window, no tabs, no file buffers.
      (delete-other-windows)
      (switch-to-buffer (get-scratch-buffer-create))
      (set-window-prev-buffers nil nil)
      (dolist (buffer (buffer-list))
        (when (buffer-file-name buffer) (kill-buffer buffer)))
      (my/workspace--restore (selected-frame) root)
      (should (= (length (window-list nil 'no-minibuffer)) 2))
      (should (equal (my/ws-test-tabs (selected-window)) left-tabs))
      (should (equal (my/ws-test-tabs (next-window)) right-tabs))
      (should (equal (file-name-nondirectory (buffer-file-name)) "b.el"))
      (should (= (line-number-at-pos (window-point)) 20))
      (with-selected-window (next-window)
        (should (= (line-number-at-pos (window-point)) 40)))
      ;; Switching back to a background tab restores its own position.
      (switch-to-buffer (get-file-buffer (expand-file-name "a.el" root)))
      (should (= (line-number-at-pos (window-point)) 10)))))

(ert-deftest my/workspace-lazy-restore-fills-tabs-in-order ()
  (my/ws-test-with-project '("a.el" "b.el" "c.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (my/ws-test-visit root "a.el" 1)
    (my/ws-test-visit root "b.el" 1)
    (my/ws-test-visit root "c.el" 1)
    (let ((tabs (my/ws-test-tabs (selected-window)))
          (my/workspace-lazy-restore t))
      (my/workspace-save nil t)
      (set-window-prev-buffers nil nil)
      (dolist (buffer (buffer-list))
        (when (buffer-file-name buffer) (kill-buffer buffer)))
      (my/workspace--restore (selected-frame) root)
      ;; Only the visible tab exists until the queue runs.
      (should (equal (my/ws-test-tabs (selected-window)) '("c.el")))
      ;; Saving before the queue ran must not lose the pending tabs.
      (my/workspace-save nil t)
      (should (null my/workspace--queue))
      (should (equal (my/ws-test-tabs (selected-window)) tabs))
      (should (= (my/workspace--count
                  (plist-get (my/workspace-read-data (my/workspace-file root)) :layout)
                  'tabs)
                 3)))))

(ert-deftest my/workspace-new-project-drops-previous-tabs ()
  (my/ws-test-with-project '("old.el")
    (let ((other (my/workspace-normalize-root (make-temp-file "workspace-other" t))))
      (unwind-protect
          (progn
            (set-frame-parameter nil 'my/workspace-root root)
            (my/ws-test-visit root "old.el" 1)
            ;; OTHER has never been saved: it must start with no old tabs.
            (my/workspace--restore (selected-frame) other)
            (should (null (my/ws-test-tabs (selected-window))))
            (should (equal default-directory other)))
        (delete-directory other t)))))

(defun my/ws-test-jump (root file line)
  "Record the current position in history, then visit FILE of ROOT at LINE."
  (xref-push-marker-stack)
  (my/ws-test-visit root file line))

(defun my/ws-test-history ()
  "Return the back stack as (FILE . LINE) pairs, most recent first."
  (mapcar (lambda (marker)
            (with-current-buffer (marker-buffer marker)
              (cons (file-name-nondirectory (buffer-file-name))
                    (line-number-at-pos marker))))
          (car (xref--get-history))))

(defun my/ws-test-forget-files ()
  "Reset to one window without tabs and kill every file buffer."
  (delete-other-windows)
  (switch-to-buffer (get-scratch-buffer-create))
  (set-window-prev-buffers nil nil)
  (set-window-next-buffers nil nil)
  (dolist (buffer (buffer-list))
    (when (buffer-file-name buffer) (kill-buffer buffer))))

(ert-deftest my/workspace-history-round-trip ()
  (my/ws-test-with-project '("a.el" "b.el" "c.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (set-frame-parameter nil 'my/xref-history nil)
    (my/ws-test-visit root "a.el" 10)
    (my/ws-test-jump root "b.el" 20)
    (my/ws-test-jump root "c.el" 30)
    (should (equal (my/ws-test-history) '(("b.el" . 20) ("a.el" . 10))))
    (my/workspace-save nil t)
    (my/ws-test-forget-files)
    (my/workspace--restore (selected-frame) root)
    (should (equal (my/ws-test-history) '(("b.el" . 20) ("a.el" . 10))))
    (xref-go-back)
    (should (equal (file-name-nondirectory (buffer-file-name)) "b.el"))
    (should (= (line-number-at-pos) 20))))

(ert-deftest my/workspace-history-drops-files-that-are-not-restored ()
  (my/ws-test-with-project '("a.el" "b.el" "c.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (set-frame-parameter nil 'my/xref-history nil)
    (my/ws-test-visit root "a.el" 10)
    (my/ws-test-jump root "b.el" 20)
    (my/ws-test-jump root "c.el" 30)
    ;; b.el stays open but is no longer a tab.
    (let ((b (get-file-buffer (expand-file-name "b.el" root))))
      (set-window-prev-buffers nil (seq-remove (lambda (entry) (eq (car entry) b))
                                               (window-prev-buffers))))
    (my/workspace-save nil t)
    (should (= (length (plist-get (plist-get (my/workspace-read-data (my/workspace-file root))
                                             :history)
                                  :back))
               2))
    (my/ws-test-forget-files)
    (my/workspace--restore (selected-frame) root)
    (should (equal (my/ws-test-history) '(("a.el" . 10))))
    (should-not (get-file-buffer (expand-file-name "b.el" root)))))

(ert-deftest my/workspace-history-waits-for-background-tabs ()
  (my/ws-test-with-project '("a.el" "b.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (set-frame-parameter nil 'my/xref-history nil)
    (my/ws-test-visit root "a.el" 10)
    (my/ws-test-jump root "b.el" 20)
    (let ((my/workspace-lazy-restore t))
      (my/workspace-save nil t)
      (my/ws-test-forget-files)
      (my/workspace--restore (selected-frame) root)
      ;; a.el is still queued, so its history entry is not installed yet.
      (should (null (my/ws-test-history)))
      ;; Saving now opens the queued tabs first and keeps the history.
      (my/workspace-save nil t)
      (should (equal (my/ws-test-history) '(("a.el" . 10))))
      (should (= (length (plist-get (plist-get (my/workspace-read-data (my/workspace-file root))
                                               :history)
                                    :back))
                 1)))))

(ert-deftest my/workspace-history-is-global-without-a-project ()
  (let ((xref--history (cons nil nil)))
    (set-frame-parameter nil 'my/workspace-root nil)
    (with-temp-buffer
      (xref-push-marker-stack)
      (should (= (length (car xref--history)) 1))
      (should (eq (xref--get-history) xref--history)))))

(ert-deftest my/workspace-files-are-stored-relative-to-root ()
  (my/ws-test-with-project '("src/x.el")
    (should (equal (my/workspace--encode-file (expand-file-name "src/x.el" root) root)
                   "src/x.el"))
    (should (equal (my/workspace--encode-file (expand-file-name "~/other.txt") root)
                   "~/other.txt"))
    (should (equal (my/workspace--decode-file "src/x.el" root)
                   (expand-file-name "src/x.el" root)))))

(ert-deftest my/workspace-skips-missing-files ()
  (my/ws-test-with-project '("keep.el" "gone.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (my/ws-test-visit root "keep.el" 5)
    (my/ws-test-visit root "gone.el" 6)
    (my/workspace-save nil t)
    (kill-buffer (get-file-buffer (expand-file-name "gone.el" root)))
    (delete-file (expand-file-name "gone.el" root))
    (my/workspace--restore (selected-frame) root)
    (should (equal (file-name-nondirectory (buffer-file-name)) "keep.el"))
    (should (= (line-number-at-pos (window-point)) 5))))

(ert-deftest my/workspace-start-page-never-overwrites-a-workspace ()
  (my/ws-test-with-project '("a.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (my/ws-test-visit root "a.el" 3)
    (my/workspace-save nil t)
    (let ((saved (my/workspace-read-data (my/workspace-file root))))
      (switch-to-buffer (get-scratch-buffer-create))
      (set-window-prev-buffers nil nil)
      (my/workspace-save nil t)
      (should (equal (plist-get (my/workspace-read-data (my/workspace-file root)) :layout)
                     (plist-get saved :layout))))))

(ert-deftest my/workspace-unchanged-state-is-not-rewritten ()
  (my/ws-test-with-project '("a.el")
    (set-frame-parameter nil 'my/workspace-root root)
    (my/ws-test-visit root "a.el" 3)
    (my/workspace-save)
    (let ((time (plist-get (my/workspace-read-data (my/workspace-file root)) :saved-at)))
      (my/workspace-save)
      (should (equal (plist-get (my/workspace-read-data (my/workspace-file root)) :saved-at)
                     time)))))

(ert-deftest my/workspace-projects-sort-pinned-then-recent ()
  (let ((my/workspace--meta nil)
        (project--list nil))
    (my/workspace-meta-update "~/old/" :opened 100.0)
    (my/workspace-meta-update "~/new/" :opened 300.0)
    (my/workspace-meta-update "~/pinned/" :opened 50.0 :pinned t)
    (should (equal (my/workspace-projects) '("~/pinned/" "~/new/" "~/old/")))
    (my/workspace-forget "~/new/")
    (should (equal (my/workspace-projects) '("~/pinned/" "~/old/")))))

(ert-deftest my/welcome-lists-projects-and-filters ()
  (let* ((my/workspace--meta nil)
         (project--list nil)
         (recentf-list nil)
         (base (make-temp-file "welcome" t))
         (alpha (my/workspace-normalize-root (expand-file-name "alpha" base)))
         (beta (my/workspace-normalize-root (expand-file-name "beta" base))))
    (make-directory alpha) (make-directory beta)
    (my/workspace-meta-update alpha :opened (float-time) :branch "main")
    (my/workspace-meta-update beta :opened (- (float-time) 7200))
    (with-current-buffer (get-buffer-create my/welcome-buffer-name)
      (my/welcome-mode)
      (my/welcome-render)
      (should (equal my/welcome-entries (list alpha beta)))
      (should (equal (my/welcome-target) (cons 'project alpha)))
      (should (string-search "just now" (buffer-string)))
      (should-not (string-search " tabs" (buffer-string)))
      (my/welcome-next 1)
      (should (equal (my/welcome-target) (cons 'project beta)))
      (my/welcome-next 1)
      (should (equal (my/welcome-target) (cons 'project beta)))
      (setq my/welcome-filter "bet")
      (my/welcome-render)
      (should (equal my/welcome-entries (list beta)))
      (kill-buffer))
    (delete-directory base t)))

(ert-deftest my/welcome-highlight-covers-only-the-content-column ()
  (let* ((my/workspace--meta nil)
         (project--list nil)
         (recentf-list nil)
         (base (make-temp-file "welcome" t))
         (long (my/workspace-normalize-root (expand-file-name "long-project" base)))
         (short (my/workspace-normalize-root (expand-file-name "s" base))))
    (make-directory long) (make-directory short)
    (my/workspace-meta-update long :opened (float-time))
    (my/workspace-meta-update short :opened (- (float-time) 60))
    (with-current-buffer (get-buffer-create my/welcome-buffer-name)
      (my/welcome-mode)
      (my/welcome-render)
      (let ((first (cons (overlay-start my/welcome--row-overlay)
                         (overlay-end my/welcome--row-overlay))))
        ;; Starts at the content margin and stops before the line end.
        (should (= (car first) (+ (line-beginning-position) my/welcome-indent)))
        (should (< (cdr first) (line-end-position)))
        (my/welcome-next 1)
        (my/welcome--update-row)
        ;; Every row ends with the same pixel-aligned spacer, so highlights
        ;; share one right edge whatever the text width.
        (let ((spacer (get-text-property (1- (cdr first)) 'display)))
          (should (eq (car-safe (cdr spacer)) :align-to))
          (should (equal (get-text-property (1- (overlay-end my/welcome--row-overlay)) 'display)
                         spacer))))
      (kill-buffer))
    (delete-directory base t)))

(ert-deftest my/welcome-point-snaps-back-to-a-row ()
  (let* ((my/workspace--meta nil)
         (project--list nil)
         (recentf-list nil)
         (base (make-temp-file "welcome" t))
         (root (my/workspace-normalize-root (expand-file-name "only" base))))
    (make-directory root)
    (my/workspace-meta-update root :opened (float-time))
    (with-current-buffer (get-buffer-create my/welcome-buffer-name)
      (my/welcome-mode)
      (my/welcome-render)
      (dolist (position (list (point-min) (point-max)))
        (goto-char position)
        (my/welcome--update-row)
        (should (equal (my/welcome-target) (cons 'project root)))
        (should (= (overlay-start my/welcome--row-overlay)
                   (+ (line-beginning-position) my/welcome-indent))))
      (kill-buffer))
    (delete-directory base t)))

(ert-deftest my/welcome-title-is-centered-by-pixels ()
  (let ((my/workspace--meta nil) (project--list nil) (recentf-list nil))
    (with-current-buffer (get-buffer-create my/welcome-buffer-name)
      (my/welcome-mode)
      (my/welcome-render)
      (goto-char (point-min))
      (search-forward "Emacs")
      (let ((spec (get-text-property (line-beginning-position) 'display)))
        (should (eq (nth 1 spec) :align-to))
        (should (eq (nth 1 (nth 2 spec)) 'center)))
      (kill-buffer))))

(ert-deftest my/welcome-time-is-right-aligned-to-the-rule ()
  (let* ((my/workspace--meta nil)
         (project--list nil)
         (recentf-list nil)
         (base (make-temp-file "welcome" t))
         (root (my/workspace-normalize-root (expand-file-name "p" base))))
    (make-directory root)
    (my/workspace-meta-update root :opened (- (float-time) 7300))
    (with-current-buffer (get-buffer-create my/welcome-buffer-name)
      (my/welcome-mode)
      (my/welcome-render)
      (let* ((end (save-excursion (search-forward "2 hours ago") (point)))
             (spacer (get-text-property (- end (length "2 hours ago") 1) 'display)))
        ;; (space :align-to (- RIGHT-EDGE (PIXELS)))
        (should (eq (nth 1 spacer) :align-to))
        (goto-char (point-min))
        (re-search-forward "─+")
        (should (= (nth 1 (nth 2 spacer))
                   (+ my/welcome-indent (length (match-string 0))))))
      (kill-buffer))
    (delete-directory base t)))

(ert-deftest my/welcome-relative-times ()
  (should (equal (my/welcome-relative-time (float-time)) "just now"))
  (should (equal (my/welcome-relative-time (- (float-time) 7300)) "2 hours ago"))
  (should (equal (my/welcome-relative-time (- (float-time) 100000)) "yesterday")))

