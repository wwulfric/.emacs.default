;;; acm-icons-tests.el --- Personal icon integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'svg)
(require 'init-acm-icons)
(defvar acm-enable-icon t)

(ert-deftest my/acm-icons-resources ()
  (dolist (entry acm-icon-alist)
    (should (equal (nth 1 entry) "expui"))
    (should (member (nth 2 entry) (expui-icons-names)))))

(ert-deftest my/acm-icons-aliases ()
  (dolist (pair '(("function" . "fun") ("constructor" . "ctor")
                  ("interface" . "i/f") ("variable" . "var")))
    (should (equal (cdr (assoc (car pair) acm-icon-alist))
                   (cdr (assoc (cdr pair) acm-icon-alist))))))

(ert-deftest my/acm-icons-disabled-and-terminal ()
  (let ((acm-enable-icon nil))
    (should (equal (acm-icon-build "expui" "nodes/class" nil) "")))
  (cl-letf (((symbol-function 'expui-icons-svg-p) (lambda () nil)))
    (should (equal (acm-icon-build "expui" "nodes/class" nil) ""))))

(ert-deftest my/acm-icons-column-and-delegation ()
  (let ((acm-enable-icon t) (acm-icon-width 4))
    (cl-letf (((symbol-function 'expui-icons-svg-p) (lambda () t))
              ((symbol-function 'expui-icons-image)
               (lambda (name &rest props) (list 'image :name name :props props))))
      (let* ((text (acm-icon-build "expui" "nodes/class" nil))
             (image (get-text-property 0 'display text)))
        (should (= (length text) acm-icon-width))
        (should (equal (plist-get (cdr image) :name) "nodes/class")))))
  (should (equal (my/acm-expui-build #'list "custom" "icon" "red")
                 '("custom" "icon" "red"))))
