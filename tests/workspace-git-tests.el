;;; workspace-git-tests.el --- Project-local Git panes -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'init-workspace)

(defmacro workspace-git-test (&rest body)
  (declare (indent 0))
  `(let* ((test-root (file-name-as-directory (make-temp-file "workspace-git-" t)))
          (root (expand-file-name "next/" test-root))
          (my/workspace-directory (expand-file-name "sessions/" test-root))
          (my/workspace--queue nil) (my/workspace--queue-timer nil)
          (saved-root (frame-parameter nil 'my/workspace-root))
          buffers shown)
     (make-directory root t)
     (make-directory my/workspace-directory t)
     (cl-labels
         ((pane (kind &optional repository)
            (let* ((buffer (generate-new-buffer (format " *workspace-%s*" kind)))
                   (window (display-buffer-in-side-window
                            buffer `((side . ,(if (eq kind 'log) 'bottom 'left))
                                     (window-height . 0.3) (window-width . 20)
                                     (window-parameters (no-delete-other-windows . t))))))
              (push buffer buffers)
              (set-window-parameter window 'test-git-kind kind)
              (set-window-parameter window 'test-git-root repository)
              window))
          (find-pane (kind &optional frame)
            (seq-find (lambda (w) (eq kind (window-parameter w 'test-git-kind)))
                      (window-list frame 'no-minibuffer)))
          (hide-pane (kind frame)
            (when-let* ((window (find-pane kind frame))) (delete-window window))))
       (unwind-protect
           (save-window-excursion
             (cl-letf (((symbol-function 'git-islands-log-window) (lambda (&optional f) (find-pane 'log f)))
                       ((symbol-function 'git-islands-commit-window) (lambda (&optional f) (find-pane 'commit f)))
                       ((symbol-function 'git-islands-log-hide) (lambda (&optional f) (hide-pane 'log f)))
                       ((symbol-function 'git-islands-commit-hide) (lambda (&optional f) (hide-pane 'commit f)))
                       ((symbol-function 'git-islands-log-show)
                        (lambda (repo) (push (cons 'log repo) shown) (pane 'log repo)))
                       ((symbol-function 'git-islands-commit-show)
                        (lambda (repo) (push (cons 'commit repo) shown) (pane 'commit repo)))
                       ((symbol-function 'my/sidebar-show) #'ignore)
                       ((symbol-function 'my/sidebar-hide) #'ignore)
                       ((symbol-function 'my/workspace-read-data) (lambda (_) nil))
                       ((symbol-function 'my/workspace-meta-update) #'ignore)
                       ((symbol-function 'my/workspace-landing-buffer)
                        (lambda (_) (let ((b (generate-new-buffer " *workspace-readme*")))
                                      (push b buffers) b)))
                       ((symbol-function 'project-current) (lambda (&rest _) nil)))
               ,@body))
         (set-frame-parameter nil 'my/workspace-root saved-root)
         (dolist (buffer buffers) (when (buffer-live-p buffer) (kill-buffer buffer)))
         (delete-directory test-root t)))))

(ert-deftest workspace-reset-removes-protected-git-panes ()
  (workspace-git-test
    (let ((log (pane 'log "/previous/")) (commit (pane 'commit "/previous/")))
      (should (window-parameter log 'no-delete-other-windows))
      (my/workspace--reset-frame (selected-frame) root)
      (should-not (window-live-p log))
      (should-not (window-live-p commit))
      (should (= 1 (length (window-list nil 'no-minibuffer)))))))

(ert-deftest workspace-switch-retargets-visible-git-panes ()
  (workspace-git-test
    (make-directory (expand-file-name ".git" root))
    (pane 'log "/previous/")
    (pane 'commit "/previous/")
    (my/workspace--restore (selected-frame) root)
    (should (equal (sort (copy-sequence shown) (lambda (a b) (string< (symbol-name (car a)) (symbol-name (car b)))))
                   (list (cons 'commit root) (cons 'log root))))
    (dolist (window (window-list nil 'no-minibuffer))
      (when (window-parameter window 'test-git-kind)
        (should (equal root (window-parameter window 'test-git-root)))))
    (should-not (window-parameter (selected-window) 'test-git-kind))))

(ert-deftest workspace-switch-does-not-open-previously-hidden-git-tools ()
  (workspace-git-test
    (make-directory (expand-file-name ".git" root))
    (my/workspace--restore (selected-frame) root)
    (should-not shown)))

(ert-deftest workspace-switch-to-non-git-closes-old-git-tools ()
  (workspace-git-test
    (pane 'log "/previous/")
    (my/workspace--restore (selected-frame) root)
    (should-not shown)
    (should-not (find-pane 'log))))
