;;; hover-performance-tests.el --- Keep hover work outside scrolling text -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'init-tab-line)
(require 'init-sidebar)

(ert-deftest my-tab-hover-skips-text-and-clears-old-target ()
  "Leaving a tab for editor/Git text must clear hover without text hit testing."
  (let ((my/tab-line-hover-target '(old-tab)) (updates 0))
    (cl-letf (((symbol-function 'my/tab-line-hover-active-p) (lambda () t))
              ((symbol-function 'mouse-pixel-position)
               (lambda () (cons (selected-frame) '(100 . 200))))
              ((symbol-function 'frame-pixel-width) (lambda (&rest _) 800))
              ((symbol-function 'frame-pixel-height) (lambda (&rest _) 600))
              ((symbol-function 'window-at-x-y) (lambda (&rest _) (selected-window)))
              ((symbol-function 'window-pixel-edges) (lambda (&rest _) '(0 0 800 600)))
              ((symbol-function 'window-tab-line-height) (lambda (&rest _) 30))
              ((symbol-function 'posn-at-x-y) (lambda (&rest _) (ert-fail "Text hit test")))
              ((symbol-function 'tab-line-force-update) (lambda (&rest _) (cl-incf updates))))
      (my/tab-line-update-hover)
      (should-not my/tab-line-hover-target)
      (should (= updates 1)))))

(ert-deftest my-tab-hover-still-detects-tabs ()
  (let ((my/tab-line-hover-target nil) (hits 0))
    (cl-letf (((symbol-function 'my/tab-line-hover-active-p) (lambda () t))
              ((symbol-function 'mouse-pixel-position)
               (lambda () (cons (selected-frame) '(100 . 10))))
              ((symbol-function 'frame-pixel-width) (lambda (&rest _) 800))
              ((symbol-function 'frame-pixel-height) (lambda (&rest _) 600))
              ((symbol-function 'window-at-x-y) (lambda (&rest _) (selected-window)))
              ((symbol-function 'window-pixel-edges) (lambda (&rest _) '(0 0 800 600)))
              ((symbol-function 'window-tab-line-height) (lambda (&rest _) 30))
              ((symbol-function 'posn-at-x-y) (lambda (&rest _) (cl-incf hits) 'position))
              ((symbol-function 'posn-area) (lambda (_) 'tab-line))
              ((symbol-function 'posn-string)
               (lambda (_) (cons (propertize "tab" 'tab 'example) 0)))
              ((symbol-function 'posn-window) (lambda (_) (selected-window)))
              ((symbol-function 'tab-line-force-update) #'ignore))
      (my/tab-line-update-hover)
      (should (= hits 1))
      (should (equal my/tab-line-hover-target (cons (selected-window) 'example))))))

(ert-deftest my-sidebar-hover-skips-other-buffers ()
  "Code and Git text must not be laid out by the sidebar tooltip timer."
  (let ((my/sidebar-name-shown nil) (hidden nil))
    (cl-letf (((symbol-function 'window-at-x-y) (lambda (&rest _) (selected-window)))
              ((symbol-function 'frame-parent) (lambda (&rest _) nil))
              ((symbol-function 'posn-at-x-y) (lambda (&rest _) (ert-fail "Text hit test")))
              ((symbol-function 'my/sidebar-name-hide) (lambda () (setq hidden t))))
      (with-temp-buffer
        (let ((my/sidebar-mode nil))
          (set-window-buffer (selected-window) (current-buffer))
          (my/sidebar-name-track (cons (selected-frame) '(100 . 200)))
          (should hidden))))))

(ert-deftest my-sidebar-hover-still-shows-shortened-names ()
  (let ((my/sidebar-name-shown nil) shown)
    (cl-letf (((symbol-function 'window-at-x-y) (lambda (&rest _) (selected-window)))
              ((symbol-function 'frame-parent) (lambda (&rest _) nil))
              ((symbol-function 'posn-at-x-y) (lambda (&rest _) 'position))
              ((symbol-function 'posn-window) (lambda (_) (selected-window)))
              ((symbol-function 'posn-point) (lambda (_) 1))
              ((symbol-function 'posn-area) (lambda (_) nil))
              ((symbol-function 'my/sidebar-name-label) (lambda (&rest _) 'label))
              ((symbol-function 'my/sidebar-name-show) (lambda (_ label) (setq shown label))))
      (with-temp-buffer
        (setq-local my/sidebar-mode t)
        (set-window-buffer (selected-window) (current-buffer))
        (my/sidebar-name-track (cons (selected-frame) '(100 . 200)))
        (should (eq shown 'label))))))

;;; hover-performance-tests.el ends here
