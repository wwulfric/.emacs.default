{
  "name": "basedpyright",
  "languageId": "python",
  "command": [
    "%USER_EMACS_DIRECTORY%.venv/bin/basedpyright-langserver",
    "--stdio"
  ],
  "settings": {
    "python.analysis": {
      "autoImportCompletions": true,
      "typeshedPaths": [],
      "stubPath": "",
      "useLibraryCodeForTypes": true,
      "diagnosticMode": "openFilesOnly",
      "typeCheckingMode": "basic",
      "logLevel": "verbose",
      "autoSearchPaths": true,
      "extraPaths": []
    }
  }
}
